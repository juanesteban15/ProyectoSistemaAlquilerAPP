@page
@model TarifasModel
@{
    ViewData["Title"] = "Tarifas";
}

<form method="post">
    <div class="text-center">
        <h1 class="display-4">Tarifas</h1>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            <div class="alert alert-danger">@ViewData["Mensaje"]</div>
        }

        <div class="mb-3">
            <button type="submit" class="btn btn-secondary" asp-page-handler="BtRefrescar">Ver tarifas</button>
            <button type="submit" class="btn btn-secondary" asp-page-handler="BtNuevo">Nueva tarifa</button>
        </div>

        @if (Model.Formulario && Model.Actual != null)
        {
            <div class="mb-4">
                <h3>@(Model.Actual.Id == 0 ? "Nueva tarifa" : "Editar tarifa")</h3>
                <input type="hidden" asp-for="Actual.Id" />

                <label asp-for="Actual.Vehiculo">Id del vehículo</label>
                <input asp-for="Actual.Vehiculo" type="number" min="1" />
                <br />

                <label asp-for="Actual.PrecioPorDia">Precio por día</label>
                <input asp-for="Actual.PrecioPorDia" type="number" min="0.01" step="0.01" />
                <br />

                <label asp-for="Actual.FechaInicio">Fecha de inicio</label>
                <input asp-for="Actual.FechaInicio" type="date" />
                <br />

                <label asp-for="Actual.Activa">Activa</label>
                <input asp-for="Actual.Activa" type="checkbox" />
                <br />

                <button type="submit" class="btn btn-primary" asp-page-handler="BtGuardar">Guardar</button>
                <button type="submit" class="btn btn-secondary" asp-page-handler="BtCancelar">Cancelar</button>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Vehículo</th>
                            <th>Precio por día</th>
                            <th>Fecha de inicio</th>
                            <th>Activa</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Vehiculo</td>
                                <td>@elemento.PrecioPorDia</td>
                                <td>@elemento.FechaInicio.ToShortDateString()</td>
                                <td>@(elemento.Activa ? "Sí" : "No")</td>
                                <td>
                                    <button type="submit" class="btn btn-secondary btn-sm"
                                            asp-page-handler="BtEditar" asp-route-data="@elemento.Id">Editar</button>
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id">Borrar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.Borrar && Model.Actual != null)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Confirmar eliminación</h3>
                    <p>¿Deseas eliminar la tarifa con Id <strong>@Model.Actual.Id</strong>?</p>
                    <input type="hidden" asp-for="Actual.Id" />
                    <button type="submit" class="btn btn-secondary" asp-page-handler="BtCancelar">Cancelar</button>
                    <button type="submit" class="btn btn-danger" asp-page-handler="BtBorrar">Confirmar</button>
                </div>
            </div>
        }
    </div>
</form>
