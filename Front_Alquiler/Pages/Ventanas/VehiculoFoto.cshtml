@page
@model VehiculoFotoModel
@{
    ViewData["Title"] = "Fotos de vehículos";
}

<form method="post" enctype="multipart/form-data">
    <div class="text-center">
        <h1 class="display-4">Fotos de vehículos</h1>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            <div class="alert alert-danger">@ViewData["Mensaje"]</div>
        }

        <div class="mb-3">
            <button type="submit" class="btn btn-secondary" asp-page-handler="BtRefrescar">Ver fotos</button>
            <button type="submit" class="btn btn-secondary" asp-page-handler="BtNuevo">Nueva foto</button>
        </div>

        @if (Model.Formulario && Model.Actual != null)
        {
            <div class="mb-4">
                <h3>@(Model.Actual.Id == 0 ? "Nueva foto" : "Editar foto")</h3>
                <input type="hidden" asp-for="Actual.Id" />
                <input type="hidden" asp-for="Actual.Ruta" />

                <label asp-for="Actual.Vehiculo">Id del vehículo</label>
                <input asp-for="Actual.Vehiculo" type="number" min="1" />
                <br />

                <label asp-for="FormFile">Imagen</label>
                <input asp-for="FormFile" type="file" accept=".jpg,.jpeg,.png,.webp" />
                <br />

                @if (!string.IsNullOrWhiteSpace(Model.Actual.Ruta))
                {
                    <img class="mt-2" height="100" width="140" alt="Foto del vehículo"
                         src="data:image/jpeg;base64,@Model.Actual.Ruta" />
                }

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" asp-page-handler="BtGuardar">Guardar</button>
                    <button type="submit" class="btn btn-secondary" asp-page-handler="BtCancelar">Cancelar</button>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Vehículo</th>
                            <th>Imagen</th>
                            <th>Ruta</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var foto in Model.Lista)
                        {
                            <tr>
                                <td>@foto.Id</td>
                                <td>@foto.Vehiculo</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(foto.Ruta))
                                    {
                                        <img height="70" width="100" alt="Foto del vehículo"
                                             src="data:image/jpeg;base64,@foto.Ruta" />
                                    }
                                </td>
                                <td>@foto.Ruta</td>
                                <td>
                                    <button type="submit" class="btn btn-secondary btn-sm"
                                            asp-page-handler="BtEditar" asp-route-data="@foto.Id">Editar</button>
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            asp-page-handler="BtPregBorrar" asp-route-data="@foto.Id">Borrar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.Borrar && Model.Actual != null)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Confirmar eliminación</h3>
                    <p>¿Deseas eliminar la foto con Id <strong>@Model.Actual.Id</strong>?</p>
                    <input type="hidden" asp-for="Actual.Id" />
                    <button type="submit" class="btn btn-secondary" asp-page-handler="BtCancelar">Cancelar</button>
                    <button type="submit" class="btn btn-danger" asp-page-handler="BtBorrar">Confirmar</button>
                </div>
            </div>
        }
    </div>
</form>
