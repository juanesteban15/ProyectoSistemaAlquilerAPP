@page
@model UsuariosModel
@{
    ViewData["Title"] = "Usuarios";
}

<form method="post">
    <div class="text-center">
        <h1 class="display-4">Usuarios</h1>


        @if (ViewData.ContainsKey("Mensaje"))
        {
            <div class="alert alert-danger">
                @ViewData["Mensaje"]
            </div>
        }

        <div>
            <input type="submit"
                   value="Ver usuarios"
                   class="btn btn-secondary"
                   asp-page-handler="BtRefrescar" />

            <input type="submit"
                   value="Buscar"
                   class="btn btn-secondary"
                   asp-page-handler="BtBuscar" />

            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />

            <input id="flUsuario"
                   placeholder="Usuario"
                   asp-for="Filtro!.NombreUsuario" />
        </div>

        @if (Model.Formulario)
        {
            <div>
                <h3>Usuarios</h3>

                <input type="hidden" asp-for="Actual!.Id" />


                
                <label>Persona</label>
                <input id="nmPersona" asp-for="Actual!._Persona" />
                <br />


                <label>Nombre de usuario</label>
                <input id="nmNombreUsuario" asp-for="Actual!.NombreUsuario" />
                <br />


                
                <label>Constraseña</label>
                <input id="nmContrasena" asp-for="Actual!.Contrasena" />
                <br />

                <label>Estado del usuario</label>
                <input id="nmEstadoUsuario" asp-for="Actual!._EstadoUsuario" />
                <br />

                <label>Rol</label>
                <input id="nmRol" asp-for="Actual!.Rol" />
                <br />

                
                <label>FotoPerfilRuta</label>
                <input id="nmFotoPerfilRuta" asp-for="Actual!.FotoPerfilRuta" />
                <br />

                <label>FechaEliminacion</label>
                <input id="nmFechaEliminacion" asp-for="Actual!.FechaEliminacion" />
                <br />

                <label>FechaCreacion</label>
                <input id="nmFechaCreacion" asp-for="Actual!.FechaCreacion" />
                <br />

           
           
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar" />

            </div>
        }



        @if (!Model.Formulario)
        {
            <br />
            <br />



            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Persona</th>
                            <th>Nombre de usuario</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Fecha de creación</th>
                        </tr>
                    </thead>
                    <tbody>


                        @if (Model.Lista != null)
                        {
                            foreach (var elemento in Model.Lista)
                            {
                                <tr>
                                    <td>@elemento.Id</td>
                                    <td>@(elemento._Persona?.Nombre) @(elemento._Persona?.Apellido)</td>
                                    <td>@elemento.NombreUsuario</td>
                                    <td>@elemento.Rol</td>
                                    <td>@(elemento._EstadoUsuario?.Nombre) </td>
                                    <td>@elemento.FechaCreacion</td>
                                    <td>

                                        <button type="submit"
                                                class="btn btn-secondary btn-sm"
                                                asp-page-handler="BtEditar"
                                                asp-route-data="@elemento.Id">
                                            Editar
                                        </button>
                                        <input type="submit"
                                               class="btn btn-danger btn-sm"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.Id" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.Borrar && Model.Actual != null)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Confirmar eliminación</h3>
                    <p>¿Deseas eliminar el usuario <strong>@Model.Actual.NombreUsuario</strong>?</p>
                    <input type="hidden" asp-for="Actual.Id" />
                    <button type="submit" class="btn btn-secondary" asp-page-handler="BtCancelarBorrar">Cancelar</button>
                    <button type="submit" class="btn btn-danger" asp-page-handler="BtBorrar">Confirmar</button>
                </div>
            </div>
        }
    </div>
</form>
