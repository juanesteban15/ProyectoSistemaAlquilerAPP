@page
@model CatalogosModel
@{
    ViewData["Title"] = "Catálogos";
    var requiereTipoVehiculo = Model.Tipo is "Categorias" or "Marcas" or "SistemasTransmisiones" or "TiposCombustibles";
}

<form method="post">
    <div class="text-center">
        <h1 class="display-4">Administrar catálogos</h1>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            <div class="alert alert-danger">@ViewData["Mensaje"]</div>
        }

        <div class="mb-3">
            <label asp-for="Tipo">Catálogo</label>
            <select asp-for="Tipo" class="form-select d-inline-block w-auto">
                @foreach (var tipo in Model.Tipos)
                {
                    <option value="@tipo.Key">@tipo.Value</option>
                }
            </select>
            <button type="submit" class="btn btn-secondary" asp-page-handler="BtRefrescar">Ver registros</button>
            <button type="submit" class="btn btn-secondary" asp-page-handler="BtNuevo">Nuevo</button>
        </div>

        @if (Model.Formulario && Model.Actual != null)
        {
            <div class="mb-4">
                <h3>@(Model.Actual.Id == 0 ? "Nuevo registro" : "Editar registro")</h3>
                <input type="hidden" asp-for="Actual.Id" />
                <label asp-for="Actual.Nombre">Nombre</label>
                <input asp-for="Actual.Nombre" class="form-control mx-auto" style="max-width: 360px" />

                @if (requiereTipoVehiculo)
                {
                    <label asp-for="Actual.TipoVehiculoId" class="mt-2">Id del tipo de vehículo</label>
                    <input asp-for="Actual.TipoVehiculoId" type="number" min="1"
                           class="form-control mx-auto" style="max-width: 360px" />
                }

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" asp-page-handler="BtGuardar">Guardar</button>
                    <button type="submit" class="btn btn-secondary" asp-page-handler="BtCancelar">Cancelar</button>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombre</th>
                            @if (requiereTipoVehiculo)
                            {
                                <th>Id tipo de vehículo</th>
                            }
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Nombre</td>
                                @if (requiereTipoVehiculo)
                                {
                                    <td>@elemento.TipoVehiculoId</td>
                                }
                                <td>
                                    <button type="submit" class="btn btn-secondary btn-sm"
                                            asp-page-handler="BtEditar"
                                            asp-route-data="@elemento.Id"
                                            asp-route-tipo="@Model.Tipo">Editar</button>
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            asp-page-handler="BtPregBorrar"
                                            asp-route-data="@elemento.Id"
                                            asp-route-tipo="@Model.Tipo">Borrar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.Borrar && Model.Actual != null)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Confirmar eliminación</h3>
                    <p>¿Eliminar <strong>@Model.Actual.Nombre</strong> (Id @Model.Actual.Id)?</p>
                    <input type="hidden" asp-for="Actual.Id" />
                    <button type="submit" class="btn btn-secondary" asp-page-handler="BtCancelar">Cancelar</button>
                    <button type="submit" class="btn btn-danger" asp-page-handler="BtBorrar">Confirmar</button>
                </div>
            </div>
        }
    </div>
</form>
