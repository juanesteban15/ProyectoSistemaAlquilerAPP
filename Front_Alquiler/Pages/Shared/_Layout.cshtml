<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Alquiler De Vehiculos </title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Front_Alquiler.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Home</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Inicio</a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Ventanas/Usuarios">Usuarios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Ventanas/Vehiculos">Vehículos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Ventanas/VehiculoFoto">Fotos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Ventanas/Reservas">Reservas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Ventanas/Catalogos">Catálogos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Ventanas/Tarifas">Tarifas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Ventanas/Personas">Personas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Ventanas/Auditoria">Auditoría</a>
                            </li>
                        }
                        else if (User.IsInRole("Cliente"))
                        {

                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-primary rounded-pill px-3"
                                   asp-page="/Ventanas/PublicarVehiculo">
                                    Publicar vehículo
                                </a>
                            </li>
                        }

                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {


                            <span>Hola , @User.Identity.Name</span>

                            <form method="post" asp-page="/Cuenta/CerrarSesion">
                                <button type="submit" class="btn btn-outline-secondary">
                                    Cerrar sesión
                                </button>
                            </form>


           
                        }
                        else
                        {
                            <a class="btn btn-outline-primary"
                               asp-page="/Cuenta/IniciarSesion">
                                Iniciar sesión
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Juan Daza - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
