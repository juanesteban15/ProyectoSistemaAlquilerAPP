@page
@model Front_Alquiler.Pages.Cuenta.IniciarSesionModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-md-6 col-lg-4">
        <h1 class="h3 mb-4">Iniciar sesión</h1>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Credenciales.Identificador" class="form-label">
                    Nombre de usuario o correo
                </label>
                <input asp-for="Credenciales.Identificador" class="form-control" />
                <span asp-validation-for="Credenciales.Identificador" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Credenciales.Contrasena" class="form-label">
                    Contraseña
                </label>
                <input asp-for="Credenciales.Contrasena"
                       type="password"
                       class="form-control" />
                <span asp-validation-for="Credenciales.Contrasena" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Iniciar sesión
            </button>

            <p class="text-center mt-3">
                ¿No tienes cuenta?
                <a asp-page="/Cuenta/Registrarse">Regístrate aquí</a>
            </p>

        </form>
    </div>
</div>